# ============================================================================
# Stellio — .gitignore
# Les dossiers de la racine sont ancrés par un « / » initial : ils ne
# masquent donc pas un dossier du même nom situé plus bas dans l'arborescence.
# ============================================================================

# --- Python : caches et fichiers générés -------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- Environnements Python et runtime embarqué -------------------------------
/venv/
/env/
/.venv/
/python/
/Lib/
/Scripts/

# --- Node.js portable (utilisé pour wrangler, non versionné) -----------------
/nodejs/
node_modules/

# --- Sorties de build et de distribution -------------------------------------
/build/
/dist/
/output/
/release/
*.spec

# --- Binaires tiers téléchargés par la CI (ffmpeg, UnRAR…) -------------------
/bin/

# --- Installeurs tiers (WebView2, VC++ Redistributable) ----------------------
/redist/
VC_redist*.exe
MicrosoftEdgeWebview2*.exe

# --- Données locales, tests et journaux --------------------------------------
/stellio-data*/
/test/
/logs/
*.log
*.db
*.sqlite
*.sqlite3
app_settings.json
encryption.key
*.diff
*.patch

# --- Secrets et certificats --------------------------------------------------
.env
.env.*
!.env.example
token*.txt
*.p12
*.pfx
*.pem
*.key

# --- Relais Cloudflare Workers (relay/ reste versionné, pas ses secrets) -----
.dev.vars
.wrangler/

# --- Projet Android local (seul l'APK est versionné, dans apk/) --------------
/StellioCompanion/

# --- Éditeurs et système -----------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
